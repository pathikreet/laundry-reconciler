# ─────────────────────────────────────────────────────────
# Laundry Reconciler — Configuration
# ─────────────────────────────────────────────────────────
# Copy this file to .env and adjust values as needed.
# All values below are the defaults. Uncomment and change
# only what you need to override.
#
# Variable names are CASE-INSENSITIVE.
# ─────────────────────────────────────────────────────────

# ── Matching Tolerances ───────────────────────────────────

# Max INR difference to consider two amounts a match (order-level)
# AMOUNT_MATCH_TOLERANCE_INR=2.0

# Day-level total comparison tolerance (INR)
# DAILY_TOTAL_TOLERANCE_INR=10.0

# Day-level total comparison tolerance (percentage)
# DAILY_TOTAL_TOLERANCE_PERCENT=0.5

# ── Fuzzy Matching ────────────────────────────────────────

# Minimum name similarity score (0.0 to 1.0) for fuzzy matching
# FUZZY_NAME_MIN_SCORE=0.82

# Max days difference between order date and event date for fuzzy matching
# FUZZY_DATE_PROXIMITY_DAYS=3

# ── MSWIPE ────────────────────────────────────────────────

# Time window (minutes) for linking MSWIPE transactions to orders
# MSWIPE_TIME_MATCH_WINDOW_MINUTES=180

# ── Cash & Credit ─────────────────────────────────────────

# Cash register variance tolerance (INR)
# CASH_VARIANCE_TOLERANCE_INR=100.0

# Cash register variance tolerance (percentage)
# CASH_VARIANCE_TOLERANCE_PERCENT=1.0

# Max unpaid balance (INR) before flagging a credit policy violation
# CREDIT_TOLERANCE_INR=1.0

# ── Late Payment Detection ────────────────────────────────

# Days after delivery before flagging a payment as late (0 = flag any post-delivery payment)
# LATE_PAYMENT_THRESHOLD_DAYS=0
